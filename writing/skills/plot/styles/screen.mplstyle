# screen.mplstyle — sans-serif, larger ticks, mathtext only (no TeX run)
# For PNGs in vault notes, READMEs, chat previews.

# Figure
figure.figsize: 6, 4.5
figure.dpi: 150
figure.titlesize: 14

# Text
text.color: 323034

# Font
font.family: sans-serif
font.sans-serif: DejaVu Sans, Arial, Helvetica, sans-serif
font.size: 12
text.usetex: False
mathtext.fontset: dejavusans

# Axes
axes.labelcolor: black
axes.edgecolor: black
axes.linewidth: 1.0
axes.labelpad: 4
axes.titlesize: 13
axes.labelsize: 12
axes.spines.right: True
axes.spines.top: True
axes.grid: True
axes.titlelocation: center
axes.formatter.use_mathtext: True
axes.autolimit_mode: round_numbers
axes.formatter.limits: -4, 4
axes.xmargin: 0
axes.ymargin: 0
axes.prop_cycle: (cycler(color=['56B4E9', 'E69F00', '009E73', '0072B2', 'D55E00', 'CC79A7', 'F0E442']) + cycler(marker=["o", "^", "s", "v", "o", "s", "^"]))

# Ticks
xtick.color: 323034
xtick.labelsize: 11
xtick.top: True
xtick.direction: in
xtick.major.size: 6
xtick.major.width: 1.0
xtick.minor.size: 3.5
xtick.minor.width: 1.0

ytick.color: 323034
ytick.labelsize: 11
ytick.right: True
ytick.direction: in
ytick.major.size: 6
ytick.major.width: 1.0
ytick.minor.size: 3.5
ytick.minor.width: 1.0

# Lines
lines.linewidth: 2.0
lines.markersize: 7
lines.markeredgewidth: 1.0
markers.fillstyle: none

# Legend
legend.framealpha: 0.9
legend.frameon: True
legend.fontsize: 11
legend.title_fontsize: 12
legend.edgecolor: 0.8
legend.borderpad: 0.3
legend.columnspacing: 1.5
legend.labelspacing: 0.5

# Patch / scatter / grid
patch.force_edgecolor: True
patch.linewidth: 1.0
scatter.edgecolors: True
grid.color: b1afb5
