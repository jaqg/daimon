{
  "preset": "scatter",
  "style": "paper",
  "layout": {
    "figsize": [
      4,
      3
    ],
    "panels": [
      {
        "series": [
          {
            "data": {
              "file": "parity.csv",
              "format": "csv",
              "x": {
                "column": "calculated"
              },
              "y": {
                "column": "experimental"
              }
            },
            "color": "sky_blue",
            "marker": "o"
          }
        ],
        "axes": {
          "x": {
            "label": "Calculated"
          },
          "y": {
            "label": "Experimental"
          }
        }
      }
    ]
  },
  "output": {
    "basename": "scatter",
    "formats": [
      "png"
    ],
    "transparent": false
  }
}
